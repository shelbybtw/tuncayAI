{
  "expo": {
    "name": "Tuncay AI",
    "slug": "tuncay-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b0d10"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shelby.tuncayai"
    },
    "android": {
      "package": "com.shelby.tuncayai",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b0d10"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Tuncay AI şəkillərinizi analiz etmək üçün qalereyanıza giriş istəyir.",
          "cameraPermission": "Tuncay AI şəkil çəkmək üçün kameranıza giriş istəyir."
        }
      ]
    ]
  }
}
